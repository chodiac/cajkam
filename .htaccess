# 301s from old cajkam.rs (WordPress) addresses that change in the redesign.
# Generated by tools/build.py - edit REDIRECTS in tools/site_lib/seo.py.
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule ^akcije\-2/?$ /akcije/ [R=301,L,NE]
RewriteRule ^cart\-2/?$ /cart/ [R=301,L,NE]
RewriteRule ^checkout\-2/?$ /checkout/ [R=301,L,NE]
RewriteRule ^kako\-do\-nas/?$ /kontakt/#kako-do-nas [R=301,L,NE]
RewriteRule ^kategorija\-proizvoda/uncategorized/?$ /kupi-gume/ [R=301,L,NE]
RewriteRule ^my\-account\-2/?$ /my-account/ [R=301,L,NE]
RewriteRule ^refund_returns\-2/?$ /reklamacije/ [R=301,L,NE]
RewriteRule ^search\-strana/?$ /kupi-gume/ [R=301,L,NE]
RewriteRule ^shop/?$ /kupi-gume/ [R=301,L,NE]
RewriteRule ^uslovi\-koriscenjasssssssssssssssss/?$ /uslovi-koriscenja/ [R=301,L,NE]
RewriteRule ^wishlist/?$ /uporedi/ [R=301,L,NE]
